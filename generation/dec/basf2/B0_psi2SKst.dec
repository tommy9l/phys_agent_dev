# Charmonium peaking background for B0 -> K*0 l+ l-:
# B0 -> psi(2S)(-> l+ l-) K*0, same visible final state as the signal.
# Vetoed in real analyses with windows in m(l+l-).


Alias      K*0sig       K*0
Alias      anti-K*0sig  anti-K*0
ChargeConj K*0sig       anti-K*0sig

Decay Upsilon(4S)
1.000  B0sig anti-B0sig B0 anti-B0   VSS_BMIX dm;
Enddecay

# Helicity amplitudes (|H+|, arg(H+), |H0|, arg(H0), |H-|, arg(H-))
# New definitions for psiKstar modes (Lange, July 26, 2000)
Define PKHplus  0.159
Define PKHzero  0.775
Define PKHminus 0.612
Define PKphHplus  1.563
Define PKphHzero  0.0
Define PKphHminus 2.712

Decay B0sig
1.000  psi(2S)sig K*0sig               SVV_HELAMP PKHminus PKphHminus PKHzero PKphHzero PKHplus PKphHplus;
Enddecay

Decay anti-B0sig
1.000  psi(2S)sig anti-K*0sig          SVV_HELAMP PKHplus PKphHplus PKHzero PKphHzero PKHminus PKphHminus;
Enddecay

Decay psi(2S)sig
0.500  e+  e-                        PHOTOS VLL;
0.500  mu+ mu-                       PHOTOS VLL;
Enddecay

Decay K*0sig
1.00 K+  pi-   PHOTOS VSS;
Enddecay
CDecay anti-K*0sig


End
